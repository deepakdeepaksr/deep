(version 1)

# MoriShield Carrier Rev C — width floors enforced by DRC.
#
# Why this file exists: net-class track_width values in .kicad_pro are routing
# defaults only; DRC never checks them. Width floors must be encoded as custom
# rules here (the file KiCad writes from Board Setup > Design Rules > Custom
# Rules). Two project-side facts discovered while wiring this up:
#   1. Net-class resolution under kicad-cli is gated on a non-empty
#      board.design_settings.rules.rules array in .kicad_pro — an inert
#      "netclass-binding-activation" entry lives there for that reason.
#   2. A rule conditioned on A.NetClass == 'Signal' silently disables the
#      whole file in this KiCad build; the global floor below replaces it.
#
# Floors encode the review-audit committed minimums, not the (higher) class
# routing defaults: Power_5V_Sens class default is 0.80 mm but the committed
# fix floor for the 0.2 mm inner-layer chain is 0.50 mm; Power_5V_Modem class
# default is 1.50 mm but short pad stubs at 0.5-1.0 mm are audit-accepted, so
# the floor catches only genuinely thin runs.
#
# Rules are evaluated in reverse file order; first matching rule wins.
# The unconditional global floor is FIRST so named rules below it win.
#
# PE floor is 0.35 mm, not the 0.6 mm the class default implies. Reason, measured:
# three PE runs are at the physical maximum of their corridors at the 0.30 mm PE
# clearance this board uses. The R47/R48 via bridge has a 1.00 mm gap between pad
# rows, so 1.00 - 2 x 0.30 = 0.40 mm is the widest track that fits; the J11 descent
# at x = 174.625 has no 0.60 mm centreline between the J11.1 pad and the I2C track
# and is 0.40 mm. Both were proved load-bearing: deleting them raises unconnected
# from 0 to 2. The floor is therefore set at the narrowest real run (0.35 mm) so
# that the rule reports nothing it cannot fix, and the three runs are recorded in
# TASK_TRACKER.md as residuals with their corridor arithmetic.
#
# Separate, still open: R9 asks for PE copper 0.5 mm or more from every other net.
# The PE net class clearance is 0.30 mm, so the board does not meet R9 today.

(rule "global floor 0.2mm"
    (constraint track_width (min 0.2mm)))

(rule "Power_5V_In width"
    (condition "A.NetClass == 'Power_5V_In'")
    (constraint track_width (min 1.5mm)))

(rule "Power_5V_Modem floor"
    (condition "A.NetClass == 'Power_5V_Modem'")
    (constraint track_width (min 0.5mm)))

(rule "Power_5V_Sens floor"
    (condition "A.NetClass == 'Power_5V_Sens'")
    (constraint track_width (min 0.5mm)))

(rule "3V3 class floor"
    (condition "A.NetClass == '3V3'")
    (constraint track_width (min 0.3mm)))

(rule "GND floor"
    (condition "A.NetClass == 'GND'")
    (constraint track_width (min 0.3mm)))

(rule "PE floor"
    (condition "A.NetClass == 'PE'")
    (constraint track_width (min 0.35mm)))

(rule "3V3_SENS_SW floor"
    (condition "A.NetName == '/3V3_SENS_SW'")
    (constraint track_width (min 0.5mm)))
