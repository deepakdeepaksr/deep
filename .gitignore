_cto_extract/REPLY*.bak*
_cto_extract/TT.bak*
_cto_extract/RT.bak*

# Old design copies kept only for reference; the live design is pcb/
4L/
6L/

# KiCad autosaves and backups inside the live design folder
pcb/*.bak
pcb/*.bak2
pcb/*.kicad_prl
pcb/_probe.kicad_prl
pcb/_geom.json
pcb/_work_20261103/scratch/
revC/_work/scratch/
