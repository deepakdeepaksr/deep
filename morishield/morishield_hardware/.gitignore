# KiCad backup / autosave / crash-recovery files
_save_*
*-save.kicad_*
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pro-bak
*.bak
*.orig
fp-info-cache

# KiCad lock / user view-state files
*.lck
.~lock*
*.kicad_prl

# KiCad 10 local history (contains a nested git repo)
.history/

# Python (helper scripts)
__pycache__/
*.py[cod]

# Generated intermediate files (committed outputs live in */reports and */fabrication)
*.net
